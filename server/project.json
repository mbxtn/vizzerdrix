{
  "name": "server",
  "projectType": "application",
  "sourceRoot": "server",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc",
        "cwd": "server"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx server.ts",
        "cwd": "server"
      }
    }
  }
}