{
  "name": "web-client",
  "projectType": "application",
  "sourceRoot": "web-client/src",
  "implicitDependencies": ["shared"],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ng serve",
        "cwd": "web-client"
      },
      "dependsOn": ["shared:build"]
    },
    "serve:dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ng serve --host 0.0.0.0 --port 4200",
        "cwd": "web-client"
      },
      "dependsOn": ["shared:build"]
    }
  }
}